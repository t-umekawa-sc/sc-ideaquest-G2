# ローカル開発の既定値（compose.yaml が参照）。実値は .env にコピーして使う（.env は追跡外）。
# compose は明示マッピング（${VAR:-default}）方式＝ここに無い変数は .env に書いても backend に届かない。
# 新しい設定を env で可変にしたい時は compose.yaml の backend_env にも追加すること。

# ---- ポート / DB / Redis ----
POSTGRES_USER=ideaquest
POSTGRES_PASSWORD=ideaquest
CONTROL_DB_NAME=ideaquest_control
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- アプリ / セッション / CORS / プロキシ ----
# メールリンクの基点（フロントの password-setup 等）。iqe2e スタックは 3100。
APP_BASE_URL=http://localhost:3000
# CORS 許可オリジン（JSON 配列・A.0）。本番はフロントの実オリジンに差し替える。
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# クライアント IP の確定（ADR-0006）。backend 手前の信頼プロキシ段数。0＝直アクセス（dev 既定）。
TRUSTED_PROXY_COUNT=0

# ---- MinIO（オブジェクトストレージ・画像/添付・§1.10） ----
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000              # backend→MinIO の内部宛先
MINIO_PUBLIC_ENDPOINT=localhost:9000   # ブラウザが署名URLを叩く公開宛先
MINIO_ACCESS_KEY=ideaquest
MINIO_SECRET_KEY=ideaquest-secret
MINIO_BUCKET=ideaquest
MINIO_SECURE=false                     # dev は HTTP（本番は TLS＝true）
MINIO_URL_TTL_SECONDS=300              # 署名URL の TTL（短命・直リンク流出耐性）

# ---- システムログ（JSONL・日次ローテーション・本番デプロイ要件.md §6.6） ----
# dev は impl/logs バインドマウント（gitignore・消えて可）。本番は永続ボリューム/ホストパスへ。
LOG_LEVEL=INFO          # DEBUG/INFO/WARNING/...（dev は DEBUG 可）
LOG_FORMAT=json         # json（機械解析）/ plain（人間可読）
LOG_TO_FILE=true        # ファイル出力 ON/OFF（stdout は常時）
LOG_DIR=/var/log/ideaquest
LOG_RETENTION_DAYS=30

# ---- メール送信（置き場所は env=ADR-0003・dev 既定は MailHog）。UI は http://localhost:8025 ----
# 本番は実SMTPの値に差し替え、SMTP_USER/SMTP_PASSWORD はシークレットマネージャ経由で供給する。
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_START_TLS=false
MAIL_FROM=no-reply@ideaquest.example
MAIL_ALERT_TO=alerts@ideaquest.example

# ---- MFA（メールOTP）・信頼端末のしきい値（ADR-0004） ----
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
PREAUTH_TTL_SECONDS=600
TRUSTED_DEVICE_TTL_SECONDS=2592000

# ---- ログインのレート制限（第一層）・一時ロック（第二層・ADR-0005） ----
LOGIN_RATE_LIMIT_MAX=50
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_LOCK_MAX_ATTEMPTS=5
LOGIN_LOCK_TTL_SECONDS=900
LOGIN_LOCK_NOTIFY_COOLDOWN_SECONDS=3600

# ---- outbox ワーカ（account_sync §4.6 / mail_outbox ADR-0007・別プロセス） ----
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL_SECONDS=1.0
MAIL_OUTBOX_MAX_ATTEMPTS=5
MAIL_OUTBOX_POLL_INTERVAL_SECONDS=1.0
MAIL_OUTBOX_SENDING_RECLAIM_SECONDS=60
MAIL_OUTBOX_DONE_RETENTION_SECONDS=604800

# メール変更のダブルオプトイン確認リンク TTL（ADR-0008・24h・単回）。
EMAIL_CHANGE_TTL_SECONDS=86400

# ---- ブートストラップ（運営テナント＋初期 system_admin・API設計 B.5.1） ----
# 本番は BOOTSTRAP_ADMIN_PASSWORD に強い秘密を供給（空だと system_admin を作らない＝既知PW禁止）。
OPS_COMPANY_CODE=OPS
BOOTSTRAP_ADMIN_LOGIN=admin@ops.example
BOOTSTRAP_ADMIN_EMAIL=admin@ops.example
BOOTSTRAP_ADMIN_PASSWORD=Passw0rd!

# ---- セルフサインアップ（FR-48②）。未設定なら現行挙動（CAPTCHA/HIBP 無効） ----
# CAPTCHA（Cloudflare Turnstile）＝site/secret とも設定で有効。ローカル検証は Cloudflare の
# テストキー（常に成功）: site=1x00000000000000000000AA / secret=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HIBP_ENABLED=false                    # 漏洩PW拒否（HIBP range API・外部呼び出し）。true で有効。
SIGNUP_DISPOSABLE_EMAIL_BLOCK=true    # 使い捨てメールドメイン拒否（ローカル blocklist・既定 ON）。
SIGNUP_ADMIN_NOTIFY_ENABLED=false     # 新規登録の管理者通知（既存 notifications/mail 基盤）。
# 既定会社コード（public デプロイのみ・ログインの会社コード欄を隠し自動セット・§8.1）。dev 共有スタックは空。
IQ_DEFAULT_COMPANY_CODE=

# ============================================================================
# AI / LLM 連携（FR-44 経営資料整合・FR-45 LLM 基盤・FR-50 AI評価・④おすすめ）
# 実生成/埋め込みには LLM 基盤（compose の Ollama・profile `ai`）が要る:
#   docker compose --profile ai up -d ollama
#   docker compose exec ollama ollama pull bge-m3          # 埋め込み（整合率）
#   docker compose exec ollama ollama pull qwen3:4b        # 生成（要約/評価 等）
# 未起動でも業務は止まらない（整合率は keyword フォールバック・AIジョブは失敗で縮退）。
# 本番は自社 vLLM 等に *_BASE_URL/*_API_KEY を差し替える。
# ============================================================================

# ---- 経営資料整合の意味的一致（A-2・OpenAI 互換 /embeddings） ----
ALIGNMENT_EMBED_BASE_URL=http://ollama:11434/v1
ALIGNMENT_EMBED_MODEL=bge-m3           # 多言語・日本語強。env で差し替え可
ALIGNMENT_EMBED_API_KEY=               # 認証が要る基盤向け（Ollama は不要＝空）
ALIGNMENT_EMBED_TIMEOUT_SECONDS=15.0

# ---- LLM ゲートウェイ / AIジョブワーカ（生成＝要約/評価/ISO生成・OpenAI 互換 chat） ----
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120.0
LLM_MAX_TOKENS=0                       # 生成トークンのグローバル上限（0=無制限・会社別上限 S.5 の技術ガード）
LLM_MODEL_LIGHT=qwen3:4b              # 論理キー qwen3-light の物理（軽量・info_summarize 既定）
LLM_MODEL_SWALLOW=hf.co/tokyotech-llm/Llama-3.1-Swallow-8B  # 高品質日本語・iso_generate
LLM_WORKER_CONCURRENCY=1              # 同時実行 N（最小スペック＝1件ずつ）
LLM_WORKER_POLL_INTERVAL_SECONDS=2.0
LLM_JOB_MAX_ATTEMPTS=3               # 失敗リトライ上限（超で failed）
LLM_JOB_RUNNING_RECLAIM_SECONDS=300 # running 無更新の孤児回収閾値

# ---- アイデア公開時の AI 自動評価（FR-50・⑥）＝既定 OFF ----
# true かつ `--profile ai llm-worker` 起動＋会社でモデル ON のとき、published で idea_evaluate を自動投入。
LLM_AUTO_EVALUATE_ON_PUBLISH=false
# AI 評価の RAG（経営資料の意味的追補）。top-k 件数・selected+topk の合計上限・採用する最小 cosine。
EVAL_RAG_STRATEGY_TOPK=3
EVAL_RAG_STRATEGY_TOTAL=5
EVAL_RAG_STRATEGY_MIN_COSINE=0.45

# ---- おすすめクエスト選出（④・SC-01 Zone D）の加重和の重み・活動窓・件数上限 ----
RECOMMEND_WEIGHT_ALIGN=0.45           # 経営資料整合率の重み
RECOMMEND_WEIGHT_ACTIVE=0.35          # 直近活発度の重み
RECOMMEND_WEIGHT_ADMIN=0.20           # 管理者お勧め（quests.recommended）のブースト
RECOMMEND_ACTIVE_WINDOW_DAYS=30       # 「直近活発」の集計窓（公開アイデア＋チャット＋参加/申請）
RECOMMEND_DEFAULT_LIMIT=3
RECOMMEND_MAX_LIMIT=10

# ---- ローカル LLM 基盤（Ollama・profile `ai`）のポート ----
OLLAMA_PORT=11434

# ---- E2E（iqe2e スタック・ワーカ別DB隔離）。通常の dev スタックは 0。 ----
E2E_WORKER_COMPANIES=0
