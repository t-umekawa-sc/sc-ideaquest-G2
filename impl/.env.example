# ローカル開発の既定値（compose が参照）。実値は .env にコピーして使う（.env は追跡外）。
POSTGRES_USER=ideaquest
POSTGRES_PASSWORD=ideaquest
CONTROL_DB_NAME=ideaquest_control
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
# MailHog（PW設定メールの dev 送信・ADR-0002 §2.5）。UI は http://localhost:8025
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
