# ローカル開発の既定値（compose が参照）。実値は .env にコピーして使う（.env は追跡外）。
POSTGRES_USER=ideaquest
POSTGRES_PASSWORD=ideaquest
CONTROL_DB_NAME=ideaquest_control
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
# MailHog（PW設定メールの dev 送信・ADR-0002 §2.5）。UI は http://localhost:8025
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# メール送信設定（置き場所は env=ADR-0003）。dev の既定は MailHog（認証なし・平文）。
# 本番は実SMTPの値に差し替え、SMTP_USER/SMTP_PASSWORD はシークレットマネージャ経由で供給する。
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_START_TLS=false
MAIL_FROM=no-reply@ideaquest.example
MAIL_ALERT_TO=alerts@ideaquest.example

# MFA（メールOTP）・信頼端末のしきい値（ADR-0004・プログラム修正なしで変更可）。
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
PREAUTH_TTL_SECONDS=600
TRUSTED_DEVICE_TTL_SECONDS=2592000

# アカウント一時ロック（ADR-0005・(IP+login_id) 単位の第二層防御）。
LOGIN_LOCK_MAX_ATTEMPTS=5
LOGIN_LOCK_TTL_SECONDS=900
LOGIN_LOCK_NOTIFY_COOLDOWN_SECONDS=3600

# クライアント IP の確定（ADR-0006）。backend 手前の信頼プロキシ段数。
# 0＝直アクセス（dev 既定）。本番はエッジ段数に一致（本番デプロイ要件.md §1）。
TRUSTED_PROXY_COUNT=0

# account_sync_outbox ワーカ（データモデル §4.6）。失敗リトライ上限とポーリング間隔。
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL_SECONDS=1.0

# mail_outbox ワーカ（認証系メール非同期・ADR-0007・別プロセス mail_worker）。
MAIL_OUTBOX_MAX_ATTEMPTS=5
MAIL_OUTBOX_POLL_INTERVAL_SECONDS=1.0
MAIL_OUTBOX_SENDING_RECLAIM_SECONDS=60
MAIL_OUTBOX_DONE_RETENTION_SECONDS=604800

# メール変更のダブルオプトイン確認リンク TTL（ADR-0008・24h・単回・otp_challenges purpose=email_change）。
EMAIL_CHANGE_TTL_SECONDS=86400

# ブートストラップ（運営テナント＋初期 system_admin・API設計 B.5.1・案a）。
# 本番は BOOTSTRAP_ADMIN_PASSWORD に強い秘密を供給（空だと system_admin を作らない＝既知PW禁止）。
OPS_COMPANY_CODE=OPS
BOOTSTRAP_ADMIN_LOGIN=admin@ops.example
BOOTSTRAP_ADMIN_EMAIL=admin@ops.example
BOOTSTRAP_ADMIN_PASSWORD=Passw0rd!

# セルフサインアップ（FR-48②）。未設定なら現行挙動のまま（CAPTCHA/HIBP 無効）。
# CAPTCHA（Cloudflare Turnstile）＝site/secret とも設定で有効。ローカル検証は Cloudflare の
# テストキー（常に成功）: site=1x00000000000000000000AA / secret=1x0000000000000000000000000000000AA
# もしくは実キー＋Turnstile 側のウィジェット設定で localhost をホスト名に追加。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 漏洩PW拒否（HIBP range API・外部呼び出し）。true で有効。
HIBP_ENABLED=false
# 使い捨てメールドメイン拒否（ローカル blocklist・外部不要）。既定 ON。
SIGNUP_DISPOSABLE_EMAIL_BLOCK=true
# 新規登録の管理者通知（既存 notifications/mail 基盤）。true で有効。
SIGNUP_ADMIN_NOTIFY_ENABLED=false
# 既定会社コード（public デプロイのみ・ログインの会社コード欄を隠し自動セット・§8.1）。dev 共有スタックでは空。
IQ_DEFAULT_COMPANY_CODE=
